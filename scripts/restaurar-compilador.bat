@echo off
rem ============================================================
rem  Restaura el compilador Leaf en una carpeta a partir de la copia
rem  de respaldo que lleva el IDE (compiler\).
rem    scripts\restaurar-compilador.bat <carpeta> [--regenerar] [--si]
rem  <carpeta>     la del compilador (la que tiene o tenia src\), por
rem                ejemplo C:\LeafPrueba. Es obligatoria: el script nunca
rem                elige una carpeta por su cuenta.
rem  --regenerar   copia solo Leaf.jjt y los .java hechos a mano y vuelve
rem                a generar el parser con jjtree y javacc (como se pide
rem                en clase). Sin esta opcion copia tambien los .java que
rem                genero JavaCC y no hace falta tener jjtree ni javacc.
rem  --si          no pregunta antes de copiar.
rem  Copia a <carpeta>\src\Leaf.jjt y <carpeta>\src\generado\, sin los dos
rem  archivos propios del IDE (ServicioCompilacion y ResultadoCompilacion),
rem  y despues compila con javac. No borra nada ni toca src\pruebas; los
rem  archivos que ya existan se sobrescriben.
rem ============================================================
setlocal EnableDelayedExpansion
chcp 65001 >nul
set "RAIZ=%~dp0.."
set "ORIGEN=%RAIZ%\compiler\src\main\java\generado"
set "DESTINO="
set "REGENERAR="
set "SIN_PREGUNTAR="

:argumentos
if "%~1"=="" goto :fin_argumentos
if /i "%~1"=="--regenerar" (
    set "REGENERAR=1"
) else if /i "%~1"=="--si" (
    set "SIN_PREGUNTAR=1"
) else if defined DESTINO (
    echo ERROR: sobra el argumento "%~1".
    goto :uso
) else (
    set "DESTINO=%~f1"
)
shift
goto :argumentos
:fin_argumentos

if not defined DESTINO goto :uso
if not exist "%DESTINO%\" (
    echo ERROR: no existe la carpeta "%DESTINO%".
    exit /b 1
)
if not exist "%ORIGEN%\VisitanteSemantico.java" (
    echo ERROR: no se encuentra la copia de respaldo en "%ORIGEN%".
    exit /b 1
)

set "VERSION=desconocida"
if exist "%RAIZ%\compiler\src\main\resources\VERSION-IMPORTADA.txt" (
    set /p VERSION=<"%RAIZ%\compiler\src\main\resources\VERSION-IMPORTADA.txt"
    set "VERSION=!VERSION:~0,7!"
)
set "SRC=%DESTINO%\src"

if defined REGENERAR (
    where jjtree >nul 2>nul || (echo ERROR: --regenerar necesita jjtree en el PATH. & exit /b 1)
    where javacc >nul 2>nul || (echo ERROR: --regenerar necesita javacc en el PATH. & exit /b 1)
)
where javac >nul 2>nul || (echo ERROR: no se encuentra javac en el PATH ^(hace falta el JDK^). & exit /b 1)

echo Se restaurara el compilador (version %VERSION% de la copia del IDE) en:
echo   %SRC%\Leaf.jjt
if defined REGENERAR (
    echo   %SRC%\generado\  ^(solo los .java hechos a mano; el parser se regenera con jjtree y javacc^)
) else (
    echo   %SRC%\generado\  ^(todos los .java, incluidos los que genero JavaCC^)
)
echo y luego se compilara con javac. Los archivos que ya existan se sobrescriben; no se borra nada.
if not defined SIN_PREGUNTAR (
    set "RESPUESTA="
    set /p RESPUESTA=Continuar? ^(S/N^):
    if /i not "!RESPUESTA!"=="S" (
        echo Cancelado. No se copio nada.
        exit /b 1
    )
)

if not exist "%SRC%\generado\" mkdir "%SRC%\generado" || exit /b 1

echo [1/3] Copiando Leaf.jjt y los .java...
copy /y "%RAIZ%\compiler\grammar\Leaf.jjt" "%SRC%\Leaf.jjt" >nul || exit /b 1
set /a COPIADOS=0
for %%F in ("%ORIGEN%\*.java") do (
    set "COPIAR=1"
    if /i "%%~nxF"=="ServicioCompilacion.java" set "COPIAR="
    if /i "%%~nxF"=="ResultadoCompilacion.java" set "COPIAR="
    if defined REGENERAR (
        findstr /m /c:"Generated By" "%%~fF" >nul && set "COPIAR="
    )
    if defined COPIAR (
        copy /y "%%~fF" "%SRC%\generado\%%~nxF" >nul || exit /b 1
        set /a COPIADOS+=1
    )
)
if not defined REGENERAR (
    copy /y "%ORIGEN%\Leaf.jj" "%SRC%\generado\Leaf.jj" >nul || exit /b 1
)
echo       !COPIADOS! archivos .java copiados.

pushd "%SRC%" || exit /b 1
if defined REGENERAR (
    echo [2/3] Regenerando el parser ^(jjtree y javacc^)...
    call jjtree Leaf.jjt || goto :fallo
    call javacc generado\Leaf.jj || goto :fallo
) else (
    echo [2/3] Sin regenerar el parser ^(se copiaron los .java de JavaCC^).
)
echo [3/3] Compilando con javac...
javac -encoding UTF-8 generado\*.java || goto :fallo
popd

echo.
echo Compilador restaurado en %SRC% ^(version %VERSION%^). Para probarlo:
echo   cd /d "%SRC%"
echo   java generado.Leaf pruebas\SumaBasica.txt
exit /b 0

:fallo
popd
echo ERROR: no se pudo terminar la restauracion.
exit /b 1

:uso
echo Uso: scripts\restaurar-compilador.bat ^<carpeta^> [--regenerar] [--si]
echo   Ejemplo: scripts\restaurar-compilador.bat C:\LeafPrueba --regenerar
exit /b 1
