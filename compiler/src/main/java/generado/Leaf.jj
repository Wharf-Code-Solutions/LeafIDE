        {
            registrarErrorSintactico(tokenParaError(e), "Error en la structure hu\u00e9rfana: " + mensajeReporteError(e));
            saltarHasta(PUNTO, EOF);
            if (getToken(1).kind == PUNTO) getNextToken();
        }
    }
}

