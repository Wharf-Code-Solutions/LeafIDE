        if (image.equals(";")) msgError = "En Leaf las instrucciones terminan con punto (\".\"), no con punto y coma (\";\").";
        else if (image.equals("=")) msgError = "El s\u00edmbolo \"=\" no es v\u00e1lido en Leaf. Usa \"con valor de\" para asignar.";
        else if (image.equals("{") || image.equals("}")) msgError = "En Leaf los bloques de c\u00f3digo se abren con \">\" y se cierran con \"<\".";

        Leaf.errores.add("Tipo de Error: L\u00e9xico L\u00ednea " + input_stream.getBeginLine() + ", Columna " + input_stream.getBeginColumn() + " : " + msgError);
