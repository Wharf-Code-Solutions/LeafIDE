PARSER_BEGIN(Leaf)
package generado;

import java.io.File;
import java.io.FileInputStream;
import java.util.ArrayList;
import java.util.Stack;
import java.util.Scanner;
import java.util.Collections;
import java.util.Comparator;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class Leaf/*@bgen(jjtree)*/implements LeafTreeConstants/*@egen*/ {/*@bgen(jjtree)*/
  protected JJTLeafState jjtree = new JJTLeafState();

/*@egen*/

    static ArrayList<String> errores = new ArrayList<String>();
    static int totalErrores = 0;
    static Stack<Token> pilaAberturas = new Stack<Token>();

    public static void main(String[] args) {
            File archivo = null;

            if (args.length > 0) {
                String ruta = args[0].trim();
                archivo = new File(ruta);
                if (!archivo.exists() || archivo.isDirectory() || !archivo.canRead()) {
                    System.out.println("Error fatal: El archivo especificado no es valido, es una carpeta o no existe: \"" + ruta + "\"");
                    System.out.println("Uso correcto: java generado.Leaf <ruta_del_archivo>");
                    return;
                }
            } else {
                Scanner teclado = new Scanner(System.in);
                while (true) {
                    System.out.println("Escriba la ruta del archivo a compilar:");
                    String ruta = teclado.nextLine().trim();
                    archivo = new File(ruta);

                    if (!archivo.exists()) {
                        System.out.println("No se encontr\u00f3 el archivo \"" + ruta + "\". Intenta de nuevo.\n");
                        continue;
                    }
                    if (archivo.isDirectory()) {
                        System.out.println("\"" + ruta + "\" es una carpeta, no un archivo. Intenta de nuevo.\n");
                        continue;
                    }
                    if (!archivo.canRead()) {
                        System.out.println("No se puede leer el archivo \"" + ruta + "\". Revisa los permisos e intenta de nuevo.\n");
                        continue;
                    }
                    break;
                }
            }

            SimpleNode raiz = null;

            try {
                FileInputStream fis = new FileInputStream(archivo);
                Leaf parser = new Leaf(fis, "UTF-8");
                raiz = parser.programa();

            } catch (java.io.FileNotFoundException e) {
                System.out.println("No se encontr\u00f3 el archivo \"" + archivo + "\".");
                return;
            } catch (ParseException e) {
                registrarErrorSintactico(tokenParaError(e), mensajeReporteError(e));
            } catch (TokenMgrError e) {
                totalErrores++;
                errores.add("Tipo de Error: L\u00e9xico : Colapso fatal del motor al leer caracteres.");
            }

            if (raiz != null) {
                LeafVisitor visitante = new VisitanteSemantico();
                raiz.jjtAccept(visitante, null);
            }

            System.out.println("\n============================================");

            if (!errores.isEmpty()) {
                System.out.println("  Se encontraron " + errores.size() + " error(es) en total:\n");

                Collections.sort(errores, new Comparator<String>() {
                    @Override
                    public int compare(String e1, String e2) {
                        return Integer.compare(extraerLinea(e1), extraerLinea(e2));
                    }
                });

                for (String err : errores) System.out.println("  " + err);
            } else {
                System.out.println("Programa v\u00e1lido. No se encontr\u00f3 ning\u00fan error.");
                //System.out.println("  \u00c1rbol AST validado exitosamente en memoria.");
            }

            System.out.println("============================================");
    }

    static int extraerLinea(String error) {
        Pattern p = Pattern.compile("L\u00ednea (\\d+)");
        Matcher m = p.matcher(error);
        if (m.find()) {
            return Integer.parseInt(m.group(1));
        }
        return Integer.MAX_VALUE;
    }

    static void registrarErrorSintactico(Token t, String mensaje) {
        totalErrores++;
        String pos = (t != null) ? "L\u00ednea " + t.beginLine + ", Columna " + t.beginColumn : "L\u00ednea ?";
        errores.add("Tipo de Error: Sint\u00e1ctico " + pos + " : " + mensaje);
    }

    static Token tokenParaError(ParseException e) {
        if (e.currentToken == null) return null;
        if (e.expectedTokenSequences != null) {
            for (int[] seq : e.expectedTokenSequences) {
                for (int k : seq) {
                    if (k == LeafConstants.PUNTO) return e.currentToken;
                }
            }
        }
        return e.currentToken.next;
    }

    static String mensajeReporteError(ParseException e) {
        Token t = (e.currentToken != null && e.currentToken.next != null) ? e.currentToken.next : e.currentToken;
        if (t == null) return e.getMessage();
        String img = t.image;

        if (t.kind == LeafConstants.DOLAR_SUELTO) return "Se encontr\u00f3 un '$' suelto o mal formado. Las variables deben llevar letras pegadas al s\u00edmbolo.";
        if (t.kind == LeafConstants.EOF) return "Fin de archivo inesperado. Revisa si olvidaste colocar un \"<\" para cerrar un bloque, un par\u00e9ntesis \")\" o una instrucci\u00f3n con \".\".";

        if (e.expectedTokenSequences != null) {
            boolean punto = false, vale = false, como = false, cierraB = false, abreB = false,
                    parenC = false, parenA = false, corchA = false, corchC = false, variable = false,
                    coma = false, entrega = false, de = false, hasta = false, veces = false,
                    flecha = false, indice = false, en = false, id = false, numero = false,
                    cadena = false, tipoDato = false, opRelacional = false, faltaMientras = false;

            for (int[] seq : e.expectedTokenSequences) {
                for (int k : seq) {
                    switch (k) {
                        case LeafConstants.PUNTO: punto = true; break;
                        case LeafConstants.VALE: vale = true; break;
                        case LeafConstants.COMO: como = true; break;
                        case LeafConstants.CIERRA_B: cierraB = true; break;
                        case LeafConstants.ABRE_B: abreB = true; break;
                        case LeafConstants.PAREN_C: parenC = true; break;
                        case LeafConstants.PAREN_A: parenA = true; break;
                        case LeafConstants.CORCH_A: corchA = true; break;
                        case LeafConstants.CORCH_C: corchC = true; break;
                        case LeafConstants.VARIABLE: variable = true; break;
                        case LeafConstants.COMA: coma = true; break;
                        case LeafConstants.ENTREGA: entrega = true; break;
                        case LeafConstants.DE: de = true; break;
                        case LeafConstants.HASTA: hasta = true; break;
                        case LeafConstants.VECES: veces = true; break;
                        case LeafConstants.FLECHA: flecha = true; break;
                        case LeafConstants.INDICE: indice = true; break;
                        case LeafConstants.EN: en = true; break;
                        case LeafConstants.ID: id = true; break;
                        case LeafConstants.NUMERO: numero = true; break;
                        case LeafConstants.CADENA: cadena = true; break;
                        case LeafConstants.ENTERO_T: case LeafConstants.DECIMAL_T: case LeafConstants.TEXTO_T:
                        case LeafConstants.LOGICO_T: case LeafConstants.VACIO_T: case LeafConstants.ARREGLO_T: tipoDato = true; break;
                        case LeafConstants.IGUAL: case LeafConstants.DIF: case LeafConstants.MAYOR_Q:
                        case LeafConstants.MENOR_Q: case LeafConstants.MAYOR_IQ: case LeafConstants.MENOR_IQ: opRelacional = true; break;
                        case LeafConstants.MIENTRAS: faltaMientras = true; break;
                    }
                }
            }

            if (punto) return "Falta \".\" al final de la instrucci\u00f3n antes de \"" + img + "\".";
            if (vale) return "Se esperaba \"con valor de\" para asignar el valor. Se encontr\u00f3: \"" + img + "\".";
            if (como) return "Se esperaba \"como\" para indicar el tipo. Se encontr\u00f3: \"" + img + "\".";
            if (entrega) return "Falta la palabra \"entrega\" para indicar el tipo que devuelve la funci\u00f3n.";
            if (tipoDato) return "Lo que se encontr\u00f3 no es un tipo de dato v\u00e1lido (\"" + img + "\").";
            if (numero || cadena) {
                if (t.kind == LeafConstants.VARIABLE || img.startsWith("$")) return "Se esperaba un valor fijo. Las constantes no pueden inicializarse usando variables.";
            }
            if (de) return "Falta \"de\" en el ciclo \"para\".";
            if (hasta) return "Falta \"hasta\" en el ciclo \"para\".";
            if (veces) return "Falta la palabra \"veces\" en el ciclo \"repetir\".";
            if (flecha) return "Falta \"->\" despu\u00e9s del valor del \"caso\".";
            if (indice) return "Falta la palabra \"\u00edndice\" despu\u00e9s de \"quitar\".";
            if (en) return "Falta la palabra \"en\" en la instrucci\u00f3n \"agregar\".";
            if (cierraB) return "Falta \"<\" para cerrar el bloque. Se encontr\u00f3: \"" + img + "\"";
            if (abreB) return "Falta \">\" para abrir el bloque despu\u00e9s de la condici\u00f3n o cabecera. Se encontr\u00f3: \"" + img + "\"";
            if (parenC) {
                if (img.equals(">") || img.equals("<")) return "Parece que usaste \"" + img + "\" dentro de los par\u00e9ntesis. Recuerda usar \"mayor que\" o \"menor que\".";
                if (img.equals("(")) return "Se encontr\u00f3 un \"(\" inesperado. Si intentabas acceder a un arreglo usa corchetes \"[\".";
                return "Falta \")\" para cerrar el par\u00e9ntesis. Se encontr\u00f3: \"" + img + "\".";
            }
            if (parenA) return "Falta \"(\" para abrir el par\u00e9ntesis. Se encontr\u00f3: \"" + img + "\".";
            if (corchC) return "Falta \"]\" para cerrar el \u00edndice o el arreglo.";
            if (corchA) {
                if (img.equals("(")) return "Se esperaban corchetes \"[\" para acceder al \u00edndice del arreglo, pero se encontr\u00f3 \"(\".";
                return "Falta \"[\" para indicar un \u00edndice o definir un arreglo.";
            }
            if (variable) return "Se esperaba una variable. Recuerda que deben empezar con \"$\". Se encontr\u00f3: \"" + img + "\".";
            if (coma) return "Falta \",\" para separar los elementos de la lista.";
            if (opRelacional) {
                if (img.equals(">") || img.equals("<")) return "En Leaf, los s\u00edmbolos \">\" y \"<\" se usan exclusivamente para bloques. Usa \"mayor que\" o \"menor que\".";
                return "Se esperaba un operador de comparaci\u00f3n. Se encontr\u00f3: \"" + img + "\".";
            }
            if (cadena) return "Se esperaba un texto entre comillas. Se encontr\u00f3: \"" + img + "\".";
            if (numero) return "Se esperaba un n\u00famero. Se encontr\u00f3: \"" + img + "\".";
            if (id) {
                if (t.kind == LeafConstants.VARIABLE || img.startsWith("$")) return "Los nombres de funci\u00f3n no deben llevar \"$\".";
                return "Se esperaba un nombre v\u00e1lido (de funci\u00f3n). Se encontr\u00f3: \"" + img + "\".";
            }
            if (faltaMientras) return "Falta la palabra \"mientras\" despu\u00e9s del bloque \"hacer\".";
        }
        return "\"" + img + "\" no es v\u00e1lido aqu\u00ed. Revisa la sintaxis de la instrucci\u00f3n.";
    }
}
PARSER_END(Leaf)

