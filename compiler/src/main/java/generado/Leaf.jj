JAVACODE
void despachador_mientras() {
    boolean esHacer = false;
    int i = 1;
    while (true) {
        Token t = getToken(i);
        if (t.kind == EOF || t.kind == ABRE_B || t.kind == CIERRA_B) break;
        if (t.kind == PUNTO) {
            esHacer = true;
            break;
        }
        i++;
    }
    if (esHacer) cola_huerfana_hacer();
    else ciclo_mientras();
}

JAVACODE
void bloque_huerfano() {
    registrarErrorSintactico(getToken(1), "Se encontr\u00f3 un bloque \"> ... <\" hu\u00e9rfano.");
    try { bloque(); } catch(Exception e) {}
}

void cola_huerfana_hacer() : {}
{
    try {
        <MIENTRAS> <PAREN_A> condicion() <PAREN_C> <PUNTO>
        { registrarErrorSintactico(getToken(0), "Se encontr\u00f3 un \"mientras\" con punto final pero falt\u00f3 la palabra \"hacer\" al inicio."); }
