/* ============================================================
 *  HELPERS JAVACODE
 * ============================================================ */

JAVACODE
void saltarHasta(int... targets) {
    while (true) {
        Token t = getToken(1);
        if (t.kind == EOF) return;
        for (int target : targets) {
            if (t.kind == target) return;
        }
        if (t.kind == CIERRA_B && !pilaAberturas.isEmpty()) pilaAberturas.pop();
        getNextToken();
    }
}

JAVACODE
String mensajeInicioInvalido(Token look) {
    switch (look.kind) {
        case FUNCION: return "No se permite declarar funciones dentro de otra funci\u00f3n, ciclo o condicional.";
        case DOLAR_SUELTO: return "Se encontr\u00f3 un '$' suelto. Las variables deben llevar letras pegadas al s\u00edmbolo.";
        case NUMERO: case DEC: return "Una instrucci\u00f3n no puede comenzar con un n\u00famero (\"" + look.image + "\").";
        case CADENA: return "Una instrucci\u00f3n no puede comenzar con un texto suelto.";
        case SI_LIT: case NO_LIT: return "Una instrucci\u00f3n no puede comenzar con un valor l\u00f3gico suelto.";
        case CASO: return "\"caso\" solo puede usarse dentro de un bloque \"seg\u00fan\".";
        case DEFECTO: return "\"defecto\" solo puede usarse dentro de un bloque \"seg\u00fan\".";
        case SINO: case SINO_SI: return "\"" + look.image + "\" no puede aparecer sin un \"si\" antes.";
        case MAS: case POR: case DIV: case POT: case MOD: case MENOS: case RAIZ: return "Una instrucci\u00f3n no puede comenzar con el operador \"" + look.image + "\".";
        case IGUAL: case DIF: case MAYOR_Q: case MENOR_Q: case MAYOR_IQ: case MENOR_IQ: return "Una instrucci\u00f3n no puede comenzar con un operador de comparaci\u00f3n.";
        case Y: case O: return "Una instrucci\u00f3n no puede comenzar con el operador l\u00f3gico \"" + look.image + "\".";
        case NO: return "\"NO\" solo se usa dentro de una condici\u00f3n; no puede empezar una instrucci\u00f3n por s\u00ed solo.";
        case VALE: return "\"con valor de\" no puede aparecer aqu\u00ed.";
        case COMO: return "\"como\" no puede aparecer aqu\u00ed.";
        case ENTREGA: return "\"entrega\" solo se usa en la cabecera de una funci\u00f3n.";
        case FLECHA: return "\"->\" solo se usa despu\u00e9s del valor de un \"caso\" dentro de un \"seg\u00fan\".";
        case DE: case HASTA: case PASO: return "\"" + look.image + "\" solo se usa en la cabecera del ciclo \"para\".";
        case VECES: return "\"veces\" solo se usa despu\u00e9s de un n\u00famero en el ciclo \"repetir\".";
        case EN: return "\"en\" solo se usa en la instrucci\u00f3n \"agregar\".";
        case INDICE: return "\"\u00edndice\" solo se usa despu\u00e9s de \"quitar\".";
        case ENTERO_T: case DECIMAL_T: case TEXTO_T: case LOGICO_T: case VACIO_T: case ARREGLO_T: return "Una instrucci\u00f3n no puede comenzar con un tipo de dato.";
        case PUNTO: return "Se encontr\u00f3 un \".\" sin ninguna instrucci\u00f3n antes.";
        case COMA: return "Se encontr\u00f3 una \",\" fuera de lugar.";
        case PAREN_A: return "Una instrucci\u00f3n no puede empezar con \"(\" suelto.";
        case PAREN_C: return "Se encontr\u00f3 un \")\" sin su \"(\" correspondiente.";
        case CORCH_A: return "Un corchete \"[\" no puede empezar una instrucci\u00f3n.";
        case CIERRA_B: if (pilaAberturas.isEmpty()) return "Se encontr\u00f3 un \"<\" de m\u00e1s; revisa que no haya un bloque cerrado dos veces."; return null;
        default: return null;
    }
}

/* ============================================================
 *  SINT\u00c1CTICO CON JJTREE (NODOS AST)
 * ============================================================ */

SimpleNode programa()           : {/*@bgen(jjtree) Programa */
  ASTPrograma jjtn000 = new ASTPrograma(JJTPROGRAMA);
  boolean jjtc000 = true;
  jjtree.openNodeScope(jjtn000);
  jjtn000.jjtSetFirstToken(getToken(1));
/*@egen*/}
{/*@bgen(jjtree) Programa */
    try {
/*@egen*/
    try {
        (
            LOOKAHEAD( { getToken(1).kind == FUNCION } ) def_funcion_segura()
          | LOOKAHEAD( { getToken(1).kind != EOF } ) sentencia_segura()
        )*
        <EOF>
    } catch (TokenMgrError e) {
        {
            Leaf.totalErrores++;
            Leaf.errores.add("Tipo de Error: L\u00e9xico : Parece que falta una comilla \" de cierre en un texto o hay un s\u00edmbolo inv\u00e1lido al final del archivo.");
        }
    }/*@bgen(jjtree)*/
    {
      jjtree.closeNodeScope(jjtn000, true);
      jjtc000 = false;
      jjtn000.jjtSetLastToken(getToken(0));
    }
/*@egen*/
    {
        while (!pilaAberturas.isEmpty()) {
            Token t = pilaAberturas.pop();
            totalErrores++;
            errores.add("Tipo de Error: Sint\u00e1ctico L\u00ednea " + t.beginLine + ", Columna " + t.beginColumn + " : Bloque abierto con \">\" en la l\u00ednea " + t.beginLine + " nunca fue cerrado con \"<\".");
        }
        return jjtn000;
    }/*@bgen(jjtree)*/
    } catch (Throwable jjte000) {
      if (jjtc000) {
        jjtree.clearNodeScope(jjtn000);
        jjtc000 = false;
      } else {
        jjtree.popNode();
      }
      if (jjte000 instanceof RuntimeException) {
        throw (RuntimeException)jjte000;
      }
      if (jjte000 instanceof ParseException) {
        throw (ParseException)jjte000;
      }
      throw (Error)jjte000;
    } finally {
      if (jjtc000) {
        jjtree.closeNodeScope(jjtn000, true);
        jjtn000.jjtSetLastToken(getToken(0));
      }
    }
/*@egen*/
}

void def_funcion_segura() : {}
{
    try {
        def_funcion()
    } catch (ParseException e) {
        {
            registrarErrorSintactico(tokenParaError(e), mensajeReporteError(e));
            saltarHasta(CIERRA_B, EOF);
            if (getToken(1).kind == CIERRA_B) getNextToken();
        }
    }
}

void sentencia_segura() : { Token look; String msgEspecial; }
{
    {
        jj_ntk = -1;
        look = getToken(1);
        msgEspecial = mensajeInicioInvalido(look);
        if (msgEspecial != null) {
            registrarErrorSintactico(look, msgEspecial);
            getNextToken();
            if (look.kind == CIERRA_B && !pilaAberturas.isEmpty()) pilaAberturas.pop();
            saltarHasta(PUNTO, CIERRA_B, ABRE_B, EOF);
            if (getToken(1).kind == PUNTO) getNextToken();
